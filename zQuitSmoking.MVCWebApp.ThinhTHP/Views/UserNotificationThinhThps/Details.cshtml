@model zQuitSmoking.Repositories.ThinhTHP.Models.UserNotificationThinhThp

@{
    ViewData["Title"] = "Details";
}

<div class="container mt-4">
    <h1 class="display-6 text-primary ms-9">Notification Details</h1>
    <hr />

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h4 class="card-title">User Notification</h4>
                    <dl class="row mb-0">
                        <dt class="col-sm-4 fw-bold text-muted">@Html.DisplayNameFor(model => model.SentDate)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.SentDate)</dd>

                        <dt class="col-sm-4 fw-bold text-muted">@Html.DisplayNameFor(model => model.IsRead)</dt>
                        <dd class="col-sm-8">
                            <span class="badge @(Model.IsRead ? "bg-success" : "bg-warning")">
                                @(Model.IsRead ? "Read" : "Unread")
                            </span>
                        </dd>

                        <dt class="col-sm-4 fw-bold text-muted">@Html.DisplayNameFor(model => model.Response)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Response)</dd>

                        <dt class="col-sm-4 fw-bold text-muted">@Html.DisplayNameFor(model => model.Status)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Status)</dd>

                        <dt class="col-sm-4 fw-bold text-muted">@Html.DisplayNameFor(model => model.AttemptCount)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.AttemptCount)</dd>

                        <dt class="col-sm-4 fw-bold text-muted">@Html.DisplayNameFor(model => model.LastAttemptDate)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.LastAttemptDate)</dd>

                        <dt class="col-sm-4 fw-bold text-muted">@Html.DisplayNameFor(model => model.NotificationThinhThp)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.NotificationThinhThp.Message)</dd>

                        <dt class="col-sm-4 fw-bold text-muted">@Html.DisplayNameFor(model => model.UserAccount)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.UserAccount.Email)</dd>
                    </dl>

                    <div class="gap-2">
                        <a asp-action="Edit" asp-route-id="@Model?.UserNotificationThinhThpid" class="btn btn-primary">
                            <i class="bi bi-pencil"></i> Edit
                        </a>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Back to List
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 0.5rem;
    }

    .ms-9 {
        margin-left: 230px;
    }

    .dl dt {
        color: #495057;
    }

    .dl dd {
        margin-bottom: 1rem;
    }

    .btn {
        border-radius: 0.375rem;
    }

    .badge {
        font-size: 0.9em;
    }
</style>