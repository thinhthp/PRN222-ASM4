@model UserNotificationThinhThpIndexViewModel

@{
    ViewData["Title"] = "Index";
}

<div class="container mt-4">
    <h1 class="display-6 text-primary">User Notifications</h1>

    <!-- Create New Button -->
    <div class="mb-3">
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Create New
        </a>
    </div>

    <!-- Search Form -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3">
                <div class="col-md-3 mt-4">
                    <input type="text" name="message" value="@Model.Message" class="form-control" placeholder="Search Message" />
                </div>
                <div class="col-md-3 mt-4">
                    <input type="text" name="response" value="@Model.Response" class="form-control" placeholder="Search Response" />
                </div>
                <div class="col-md-3 mt-4">
                    <input type="text" name="userName" value="@Model.UserName" class="form-control" placeholder="Search User Name" />
                </div>
                <div class="col-md-2 mt-4">
                    <select name="pageSize" class="form-select">
                        <option value="10" @@(Model.PageSize == 10 ? "selected" : "")>10 per page</option>
                        <option value="20" @@(Model.PageSize == 20 ? "selected" : "")>20 per page</option>
                        <option value="50" @@(Model.PageSize == 50 ? "selected" : "")>50 per page</option>
                    </select>
                </div>
                <div class="col-md-1">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search"></i> Search
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Table -->
    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover table-striped">
                    <thead class="table-primary">
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.Items[0].SentDate)</th>
                            <th>@Html.DisplayNameFor(model => model.Items[0].IsRead)</th>
                            <th>@Html.DisplayNameFor(model => model.Items[0].Response)</th>
                            <th>@Html.DisplayNameFor(model => model.Items[0].Status)</th>
                            <th>@Html.DisplayNameFor(model => model.Items[0].AttemptCount)</th>
                            <th>@Html.DisplayNameFor(model => model.Items[0].LastAttemptDate)</th>
                            <th>@Html.DisplayNameFor(model => model.Items[0].NotificationThinhThp.Message)</th>
                            <th>@Html.DisplayNameFor(model => model.Items[0].UserAccount.UserName)</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Items.Any())
                        {
                            <tr>
                                <td colspan="9" class="text-center text-muted">No records found.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>@Html.DisplayFor(modelItem => item.SentDate)</td>
                                    <td>
                                        <span class="badge @(item.IsRead ? "bg-success" : "bg-warning")">
                                            @(item.IsRead ? "Read" : "Unread")
                                        </span>
                                    </td>
                                    <td>@Html.DisplayFor(modelItem => item.Response)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Status)</td>
                                    <td>@Html.DisplayFor(modelItem => item.AttemptCount)</td>
                                    <td>@Html.DisplayFor(modelItem => item.LastAttemptDate)</td>
                                    <td>@Html.DisplayFor(modelItem => item.NotificationThinhThp.Message)</td>
                                    <td>@Html.DisplayFor(modelItem => item.UserAccount.UserName)</td>
                                    <td>
                                        <a asp-action="Edit" asp-route-id="@item.UserNotificationThinhThpid" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.UserNotificationThinhThpid" class="btn btn-sm btn-outline-info">
                                            <i class="bi bi-eye"></i> Details
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.UserNotificationThinhThpid" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i> Delete
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Pagination and Info -->
    @{
        int start = (Model.CurrentPage - 1) * Model.PageSize + 1;
        int end = Math.Min(start + Model.Items.Count - 1, Model.TotalCount);
        int total = Model.TotalCount;
    }

    <div class="d-flex justify-content-between align-items-center mt-3">
        <p class="mb-0 text-muted">Showing @start to @end of @total entries</p>
        @if (Model.TotalPages > 1)
        {
            <nav>
                <ul class="pagination mb-0">
                    @if (Model.CurrentPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Index", new { pageNumber = Model.CurrentPage - 1, pageSize = Model.PageSize, message = Model.Message, response = Model.Response, userName = Model.UserName })" aria-label="Previous">
                                <span aria-hidden="true">&laquo; Previous</span>
                            </a>
                        </li>
                    }
                    @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { pageNumber = i, pageSize = Model.PageSize, message = Model.Message, response = Model.Response, userName = Model.UserName })">@i</a>
                        </li>
                    }
                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Index", new { pageNumber = Model.CurrentPage + 1, pageSize = Model.PageSize, message = Model.Message, response = Model.Response, userName = Model.UserName })" aria-label="Next">
                                <span aria-hidden="true">Next &raquo;</span>
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>

<style>
    .table th, .table td {
        vertical-align: middle;
    }
    .badge {
        font-size: 0.9em;
    }
    .pagination .page-link {
        border-radius: 0.25rem;
        margin: 0 2px;
    }
    .pagination .page-item.active .page-link {
        background-color: #007bff;
        border-color: #007bff;
    }
    .card {
        border-radius: 0.5rem;
    }
</style>