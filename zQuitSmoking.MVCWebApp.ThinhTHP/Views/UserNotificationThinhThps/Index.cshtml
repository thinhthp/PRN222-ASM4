@model IEnumerable<zQuitSmoking.Repositories.ThinhTHP.Models.UserNotificationThinhThp>

@{
    ViewData["Title"] = "Notification Management";
}

<style>
    .notification-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        border-radius: 15px 15px 0 0;
    }

    .notification-card {
        border: none;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }

    .stats-card {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        border: none;
        border-radius: 12px;
        color: white;
    }

    .filter-section {
        background: #f8f9fc;
        border-radius: 12px;
        border: 1px solid #e3e6f0;
    }

    .table-hover tbody tr:hover {
        background-color: #f1f3ff;
        transform: translateY(-1px);
        transition: all 0.2s ease;
    }

    .status-badge {
        font-size: 0.75rem;
        padding: 0.35em 0.65em;
        border-radius: 50rem;
        font-weight: 600;
    }

    /* Enhanced Action Buttons Styling */
    .action-buttons {
        display: flex;
        gap: 8px;
        justify-content: center;
        align-items: center;
    }

        .action-buttons .btn {
            width: 36px;
            height: 36px;
            border-radius: 8px;
            font-size: 0.875rem;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid;
            position: relative;
            overflow: hidden;
        }

            .action-buttons .btn::before {
                content: '';
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 100%;
                background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
                transition: left 0.5s;
            }

            .action-buttons .btn:hover::before {
                left: 100%;
            }

            .action-buttons .btn:hover {
                transform: translateY(-2px) scale(1.05);
                box-shadow: 0 8px 25px rgba(0,0,0,0.15);
            }

    /* Specific button styles */
    .btn-action-view {
        background: linear-gradient(135deg, #17a2b8, #138496);
        border-color: #17a2b8;
        color: white;
    }

        .btn-action-view:hover {
            background: linear-gradient(135deg, #138496, #117a8b);
            border-color: #138496;
            color: white;
            box-shadow: 0 8px 25px rgba(23, 162, 184, 0.4);
        }

    .btn-action-edit {
        background: linear-gradient(135deg, #007bff, #0056b3);
        border-color: #007bff;
        color: white;
    }

        .btn-action-edit:hover {
            background: linear-gradient(135deg, #0056b3, #004085);
            border-color: #0056b3;
            color: white;
            box-shadow: 0 8px 25px rgba(0, 123, 255, 0.4);
        }

    .btn-action-delete {
        background: linear-gradient(135deg, #dc3545, #c82333);
        border-color: #dc3545;
        color: white;
    }

        .btn-action-delete:hover {
            background: linear-gradient(135deg, #c82333, #bd2130);
            border-color: #c82333;
            color: white;
            box-shadow: 0 8px 25px rgba(220, 53, 69, 0.4);
        }

    /* Filter status indicator */
    .filter-status {
        background-color: #e3f2fd;
        border-radius: 8px;
        padding: 8px 12px;
        margin-top: 12px;
        border-left: 4px solid #2196f3;
        font-size: 0.875rem;
    }

    .filter-clear-btn {
        background: none;
        border: none;
        color: #2196f3;
        text-decoration: underline;
        cursor: pointer;
        font-size: 0.875rem;
    }

    .priority-high {
        border-left: 4px solid #dc3545;
    }

    .priority-medium {
        border-left: 4px solid #ffc107;
    }

    .priority-low {
        border-left: 4px solid #28a745;
    }

    .fade-in {
        animation: fadeIn 0.5s ease-in;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .search-box {
        background: white;
        border: 2px solid #e3e6f0;
        border-radius: 25px;
        padding: 10px 20px;
        transition: all 0.3s ease;
    }

        .search-box:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
        }

    /* Responsive adjustments for action buttons */
    @@media (max-width: 768px) {
        .action-buttons {
            flex-direction: column;
            gap: 4px;
        }

            .action-buttons .btn {
                width: 32px;
                height: 32px;
                font-size: 0.75rem;
            }
    }
</style>

<div class="container-fluid mt-4 fade-in">
    <!-- Header Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card notification-card">
                <div class="card-header notification-header text-white py-4">
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <h1 class="mb-0 d-flex align-items-center">
                                <i class="fas fa-bell me-3" style="font-size: 1.5rem;"></i>
                                Notification Management
                            </h1>
                            <p class="mb-0 mt-2 opacity-75">Manage and monitor user notifications</p>
                        </div>
                        <div class="col-md-6 text-end">
                            <a asp-action="Create" class="btn btn-light btn-lg px-4">
                                <i class="fas fa-plus me-2"></i>Create New Notification
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row mb-4">
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card stats-card">
                <div class="card-body text-center py-3">
                    <i class="fas fa-envelope-open text-white-50 fa-2x mb-2"></i>
                    <h5 class="card-title mb-0">@Model.Count(n => n.IsRead)</h5>
                    <small>Read Notifications</small>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card" style="background: linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%); border: none; border-radius: 12px; color: white;">
                <div class="card-body text-center py-3">
                    <i class="fas fa-envelope text-white-50 fa-2x mb-2"></i>
                    <h5 class="card-title mb-0">@Model.Count(n => !n.IsRead)</h5>
                    <small>Unread Notifications</small>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card" style="background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%); border: none; border-radius: 12px; color: white;">
                <div class="card-body text-center py-3">
                    <i class="fas fa-paper-plane text-white-50 fa-2x mb-2"></i>
                    <h5 class="card-title mb-0">@Model.Count()</h5>
                    <small>Total Notifications</small>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card" style="background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%); border: none; border-radius: 12px; color: white;">
                <div class="card-body text-center py-3">
                    <i class="fas fa-user-friends text-white-50 fa-2x mb-2"></i>
                    <h5 class="card-title mb-0">@Model.Select(n => n.UserAccount.Email).Distinct().Count()</h5>
                    <small>Active Users</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card filter-section p-4">
                <div class="row align-items-center">
                    <div class="col-md-3">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0">
                                <i class="fas fa-search text-muted"></i>
                            </span>
                            <input type="text" class="form-control border-start-0 search-box" placeholder="Search notifications..." id="searchInput">
                        </div>
                    </div>
                    <div class="col-md-2">
                        <select class="form-select" id="statusFilter">
                            <option value="">All Status</option>
                            <option value="read">Read</option>
                            <option value="unread">Unread</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select class="form-select" id="dateFilter">
                            <option value="">All Dates</option>
                            <option value="today">Today</option>
                            <option value="week">This Week</option>
                            <option value="month">This Month</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <div class="d-flex gap-2">
                            <button class="btn btn-outline-secondary" onclick="clearAllFilters()">
                                <i class="fas fa-times me-1"></i>Clear Filters
                            </button>
                            <button class="btn btn-outline-primary" onclick="exportData()">
                                <i class="fas fa-download me-1"></i>Export
                            </button>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="text-center">
                            <small class="text-muted">Showing: <span id="visibleCount">@Model.Count()</span> of @Model.Count()</small>
                        </div>
                    </div>
                </div>

                <!-- Filter Status Display -->
                <div id="filterStatus" class="filter-status" style="display: none;">
                    <div class="d-flex justify-content-between align-items-center">
                        <span id="filterText">Active filters: </span>
                        <button class="filter-clear-btn" onclick="clearAllFilters()">Clear all</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="row">
        <div class="col-12">
            <div class="card notification-card">
                <div class="card-body p-0">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0" id="notificationsTable">
                                <thead style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                                    <tr>
                                        <th class="border-0 py-3">
                                            <i class="fas fa-calendar-alt me-2"></i>Sent Date
                                        </th>
                                        <th class="border-0 py-3">
                                            <i class="fas fa-eye me-2"></i>Status
                                        </th>
                                        <th class="border-0 py-3">
                                            <i class="fas fa-comment me-2"></i>Response
                                        </th>
                                        <th class="border-0 py-3">
                                            <i class="fas fa-info-circle me-2"></i>Delivery Status
                                        </th>
                                        <th class="border-0 py-3">
                                            <i class="fas fa-redo me-2"></i>Attempts
                                        </th>
                                        <th class="border-0 py-3">
                                            <i class="fas fa-clock me-2"></i>Last Attempt
                                        </th>
                                        <th class="border-0 py-3">
                                            <i class="fas fa-envelope me-2"></i>Message
                                        </th>
                                        <th class="border-0 py-3">
                                            <i class="fas fa-user me-2"></i>User
                                        </th>
                                        <th class="border-0 py-3 text-center">
                                            <i class="fas fa-cog me-2"></i>Actions
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr class="align-middle"
                                            data-sent-date="@(item.SentDate?.ToString("yyyy-MM-dd") ?? "")"
                                            data-status="@(item.IsRead ? "read" : "unread")"
                                            data-search-text="@($"{item.Response} {item.Status} {item.NotificationThinhThp?.Message} {item.UserAccount?.Email}".ToLower())">
                                            <td class="py-3">
                                                <div class="d-flex align-items-center">
                                                    <i class="fas fa-calendar text-muted me-2"></i>
                                                    <span>@(item.SentDate.HasValue ? item.SentDate.Value.ToString("MMM dd, yyyy") : "N/A")</span>
                                                </div>
                                                @if (item.SentDate.HasValue)
                                                {
                                                    <small class="text-muted">@item.SentDate.Value.ToString("HH:mm")</small>
                                                }
                                            </td>
                                            <td class="py-3">
                                                @if (item.IsRead)
                                                {
                                                    <span class="badge bg-success status-badge">
                                                        <i class="fas fa-check me-1"></i>Read
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning status-badge">
                                                        <i class="fas fa-exclamation me-1"></i>Unread
                                                    </span>
                                                }
                                            </td>
                                            <td class="py-3">
                                                @if (!string.IsNullOrEmpty(item.Response))
                                                {
                                                    <div class="text-truncate" style="max-width: 150px;" title="@item.Response">
                                                        <i class="fas fa-comment-dots text-primary me-1"></i>
                                                        @(item.Response.Length > 30 ? item.Response.Substring(0, 30) + "..." : item.Response)
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">
                                                        <i class="fas fa-minus me-1"></i>No response
                                                    </span>
                                                }
                                            </td>
                                            <td class="py-3">
                                                <span class="badge bg-info status-badge">@item.Status</span>
                                            </td>
                                            <td class="py-3">
                                                <div class="d-flex align-items-center">
                                                    <div class="progress" style="width: 30px; height: 6px;">
                                                        <div class="progress-bar bg-primary" style="width: @((item.AttemptCount ?? 0) * 20)%"></div>
                                                    </div>
                                                    <span class="ms-2">@(item.AttemptCount ?? 0)</span>
                                                </div>
                                            </td>
                                            <td class="py-3">
                                                @if (item.LastAttemptDate.HasValue)
                                                {
                                                    <div>
                                                        <span>@item.LastAttemptDate.Value.ToString("MMM dd")</span>
                                                        <br><small class="text-muted">@item.LastAttemptDate.Value.ToString("HH:mm")</small>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">N/A</span>
                                                }
                                            </td>
                                            <td class="py-3">
                                                <div class="text-truncate" style="max-width: 200px;" title="@item.NotificationThinhThp.Message">
                                                    <i class="fas fa-envelope-open-text text-info me-1"></i>
                                                    @(item.NotificationThinhThp.Message?.Length > 40 ? item.NotificationThinhThp.Message.Substring(0, 40) + "..." : item.NotificationThinhThp.Message ?? "N/A")
                                                </div>
                                            </td>
                                            <td class="py-3">
                                                <div class="d-flex align-items-center">
                                                    <div class="avatar-sm me-2">
                                                        <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                                            <span class="text-white fw-bold">@item.UserAccount.Email.Substring(0, 1).ToUpper()</span>
                                                        </div>
                                                    </div>
                                                    <div>
                                                        <div class="fw-medium">@item.UserAccount.Email</div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="py-3 text-center">
                                                <div class="action-buttons">
                                                    <a asp-action="Details" asp-route-id="@item.UserNotificationThinhThpid"
                                                       class="btn btn-action-view" title="View Details"
                                                       data-bs-toggle="tooltip" data-bs-placement="top">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <a asp-action="Edit" asp-route-id="@item.UserNotificationThinhThpid"
                                                       class="btn btn-action-edit" title="Edit Notification"
                                                       data-bs-toggle="tooltip" data-bs-placement="top">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <a asp-action="Delete" asp-route-id="@item.UserNotificationThinhThpid"
                                                       class="btn btn-action-delete" title="Delete Notification"
                                                       data-bs-toggle="tooltip" data-bs-placement="top"
                                                       onclick="return confirm('Are you sure you want to delete this notification?')">
                                                        <i class="fas fa-trash-alt"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-bell-slash fa-3x text-muted mb-3"></i>
                            <h4 class="text-muted">No Notifications Found</h4>
                            <p class="text-muted">There are no notifications to display at the moment.</p>
                            <a asp-action="Create" class="btn btn-primary">
                                <i class="fas fa-plus me-2"></i>Create First Notification
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Global filter state
    let currentFilters = {
        search: '',
        status: '',
        date: ''
    };

    // Combined filter function that applies all filters simultaneously
    function applyAllFilters() {
        const rows = document.querySelectorAll('#notificationsTable tbody tr');
        let visibleCount = 0;
        const today = new Date();

        rows.forEach(row => {
            let showRow = true;

            // Search filter
            if (currentFilters.search) {
                const searchText = row.getAttribute('data-search-text') || '';
                if (!searchText.includes(currentFilters.search.toLowerCase())) {
                    showRow = false;
                }
            }

            // Status filter
            if (currentFilters.status) {
                const rowStatus = row.getAttribute('data-status');
                if (rowStatus !== currentFilters.status) {
                    showRow = false;
                }
            }

            // Date filter
            if (currentFilters.date) {
                const sentDateStr = row.getAttribute('data-sent-date');
                if (sentDateStr) {
                    const sentDate = new Date(sentDateStr);
                    let dateMatches = false;

                    switch (currentFilters.date) {
                        case 'today':
                            dateMatches = sentDate.toDateString() === today.toDateString();
                            break;
                        case 'week':
                            const weekAgo = new Date(today);
                            weekAgo.setDate(today.getDate() - 7);
                            dateMatches = sentDate >= weekAgo && sentDate <= today;
                            break;
                        case 'month':
                            const monthAgo = new Date(today);
                            monthAgo.setMonth(today.getMonth() - 1);
                            dateMatches = sentDate >= monthAgo && sentDate <= today;
                            break;
                    }

                    if (!dateMatches) {
                        showRow = false;
                    }
                } else {
                    // If no sent date and date filter is active, hide the row
                    showRow = false;
                }
            }

            // Show/hide row
            row.style.display = showRow ? '' : 'none';
            if (showRow) visibleCount++;
        });

        // Update visible count
        document.getElementById('visibleCount').textContent = visibleCount;

        // Update filter status
        updateFilterStatus();
    }

    // Update filter status display
    function updateFilterStatus() {
        const filterStatus = document.getElementById('filterStatus');
        const filterText = document.getElementById('filterText');
        const activeFilters = [];

        if (currentFilters.search) {
            activeFilters.push(`Search: "${currentFilters.search}"`);
        }
        if (currentFilters.status) {
            activeFilters.push(`Status: ${currentFilters.status}`);
        }
        if (currentFilters.date) {
            const dateLabels = {
                'today': 'Today',
                'week': 'This Week',
                'month': 'This Month'
            };
            activeFilters.push(`Date: ${dateLabels[currentFilters.date]}`);
        }

        if (activeFilters.length > 0) {
            filterText.textContent = `Active filters: ${activeFilters.join(', ')}`;
            filterStatus.style.display = 'block';
        } else {
            filterStatus.style.display = 'none';
        }
    }

    // Clear all filters
    function clearAllFilters() {
        currentFilters = { search: '', status: '', date: '' };
        document.getElementById('searchInput').value = '';
        document.getElementById('statusFilter').value = '';
        document.getElementById('dateFilter').value = '';
        applyAllFilters();
    }

    // Search functionality
    document.getElementById('searchInput').addEventListener('keyup', function() {
        currentFilters.search = this.value;
        applyAllFilters();
    });

    // Status filter
    document.getElementById('statusFilter').addEventListener('change', function() {
        currentFilters.status = this.value;
        applyAllFilters();
    });

    // Date filter
    document.getElementById('dateFilter').addEventListener('change', function() {
        currentFilters.date = this.value;
        applyAllFilters();
    });

    // Export functionality
    function exportData() {
        // Get only visible rows for export
        const table = document.getElementById('notificationsTable');
        let csv = [];
        const headerRow = table.querySelector('thead tr');
        const headers = [];

        // Get headers (excluding actions column)
        const headerCells = headerRow.querySelectorAll('th');
        for (let i = 0; i < headerCells.length - 1; i++) {
            headers.push(headerCells[i].textContent.trim());
        }
        csv.push(headers.join(','));

        // Get visible data rows
        const visibleRows = table.querySelectorAll('tbody tr[style=""], tbody tr:not([style*="display: none"])');
        visibleRows.forEach(row => {
            const rowData = [];
            const cells = row.querySelectorAll('td');
            for (let i = 0; i < cells.length - 1; i++) { // Exclude actions column
                rowData.push('"' + cells[i].textContent.trim().replace(/"/g, '""') + '"');
            }
            csv.push(rowData.join(','));
        });

        // Create and download file
        const csvContent = csv.join('\n');
        const csvFile = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
        const downloadLink = document.createElement('a');
        downloadLink.download = `notifications_filtered_${new Date().toISOString().split('T')[0]}.csv`;
        downloadLink.href = window.URL.createObjectURL(csvFile);
        downloadLink.style.display = 'none';
        document.body.appendChild(downloadLink);
        downloadLink.click();
        document.body.removeChild(downloadLink);
    }

    // Enhanced tooltip initialization
    document.addEventListener('DOMContentLoaded', function() {
        // Initialize Bootstrap tooltips
        if (typeof bootstrap !== 'undefined' && bootstrap.Tooltip) {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        }

        // Fallback for title attribute tooltips
        const titleTooltips = [].slice.call(document.querySelectorAll('[title]:not([data-bs-toggle="tooltip"])'));
        titleTooltips.map(function(tooltipTriggerEl) {
            if (typeof bootstrap !== 'undefined' && bootstrap.Tooltip) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            }
        });
    });
</script>

