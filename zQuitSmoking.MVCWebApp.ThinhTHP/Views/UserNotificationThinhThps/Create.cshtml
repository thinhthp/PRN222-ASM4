@model zQuitSmoking.Repositories.ThinhTHP.Models.UserNotificationThinhThp

@{
    ViewData["Title"] = "Create";
}

<div class="container mt-4">
    <h1 class="display-6 text-primary justify-content-center d-flex">Create User Notification</h1>
    <hr />

    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h4 class="card-title">New Notification</h4>
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="UserAccountId" class="form-label fw-bold"></label>
                            <select asp-for="UserAccountId" class="form-select" asp-items="ViewBag.UserAccountId">
                                <option value="">Select User</option>
                            </select>
                            <span asp-validation-for="UserAccountId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NotificationThinhThpid" class="form-label fw-bold"></label>
                            <select asp-for="NotificationThinhThpid" class="form-select" asp-items="ViewBag.NotificationThinhThpid">
                                <option value="">Select Notification</option>
                            </select>
                            <span asp-validation-for="NotificationThinhThpid" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Response" class="form-label fw-bold"></label>
                            <input asp-for="Response" class="form-control" placeholder="Enter response" />
                            <span asp-validation-for="Response" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Status" class="form-label fw-bold"></label>
                            <input asp-for="Status" class="form-control" placeholder="Enter status" />
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="LastAttemptDate" class="form-label fw-bold"></label>
                            <input asp-for="LastAttemptDate" class="form-control" type="datetime-local" />
                            <span asp-validation-for="LastAttemptDate" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> Create
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Back to List
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<style>
    .card {
        border-radius: 0.5rem;
    }

    .form-label {
        color: #495057;
    }

    .form-control, .form-select {
        border-radius: 0.375rem;
    }

    .btn {
        border-radius: 0.375rem;
    }
</style>